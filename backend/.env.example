# Database Configuration (PostgreSQL - REQUIRED)
# Copy this file to .env and update with your actual values
# PostgreSQL is required - SQLite is not supported

DB_NAME=shipping_db
DB_USER=shipping_user
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# Address Validation API Keys
# USPS Addresses 3.0 API (NEW - OAuth-based)
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
USPS_USE_TEM=False

# USPS Web Tools API (LEGACY - Deprecated, shutting down Jan 25, 2026)
USPS_API_KEY=

# Google Maps Geocoding API
GOOGLE_MAPS_API_KEY=

# SmartyStreets API
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=

# Lob Address Verification API
LOB_API_KEY=
